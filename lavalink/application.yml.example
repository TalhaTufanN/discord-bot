server:
  port: 2333
  # SADECE localhost. Disari acilmiyor; botlar ayni makinede.
  address: 127.0.0.1

lavalink:
  plugins:
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.1"
      repository: "https://maven.lavalink.dev/releases"
      snapshot: false
    # Spotify linklerini (sarki/album/playlist) cozup YouTube'dan calmak icin.
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.3"
      repository: "https://maven.lavalink.dev/releases"
      snapshot: false
  server:
    password: "${LAVALINK_PASSWORD}"   # gercek deger VPS-teki application.yml-de
    sources:
      # Dahili youtube KAPALI olmali; youtube-source plugin'i devraliyor.
      youtube: false
      bandcamp: false
      soundcloud: true
      twitch: false
      vimeo: false
      nico: false
      http: true   # radyo istasyonlari (stations.js) icin
      local: true  # yerel Sagopa dosyalari icin
    filters:
      volume: true
      equalizer: true
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: LOW
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    youtubePlaylistLoadLimit: 6
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    # Datacenter IP icin sira onemli: ANDROID_VR PO-token istemiyor,
    # MUSIC de genelde datacenter'dan gecebiliyor.
    clients:
      - MUSIC
      - ANDROID_VR
      - WEB
      - WEBEMBEDDED

  lavasrc:
    # Spotify sadece METADATA kaynagi; ses YouTube'dan geliyor ("mirror").
    # ISRC birebir kayit eslesmesi verdigi icin once o denenir, bulunamazsa
    # "sanatci - parca" metniyle YouTube aramasi yapilir.
    providers:
      - "ytsearch:\"%ISRC%\""
      - "ytsearch:%QUERY%"
    sources:
      spotify: true
      # ONEMLI: LavaSrc'nin kendi youtube kaynagi KAPALI kalmali, yoksa
      # dev.lavalink.youtube (youtube-source) plugin'ini gasp eder ve
      # datacenter IP'de calisan ANDROID_VR/MUSIC client zinciri devre disi kalir.
      youtube: false
      applemusic: false
      deezer: false
      yandexmusic: false
      flowerytts: false
      vkmusic: false
      tidal: false
      qobuz: false
    spotify:
      # Degerler .env'den geliyor (ecosystem.config.js pm2 env'ine koyuyor).
      # ":" sonrasi bos varsayilan: kimlik bilgisi yoksa Lavalink yine de
      # aciliyor, sadece Spotify calismiyor — YouTube/radyo/Sagopa etkilenmiyor.
      clientId: "${SPOTIFY_CLIENT_ID:}"
      clientSecret: "${SPOTIFY_CLIENT_SECRET:}"
      countryCode: "TR"
      # 6 x 100 = 600 parcaya kadar
      playlistLoadLimit: 6
      albumLoadLimit: 6
      resolveArtistsInSearch: true
      localFiles: false

metrics:
  prometheus:
    enabled: false

logging:
  level:
    root: INFO
    lavalink: INFO
